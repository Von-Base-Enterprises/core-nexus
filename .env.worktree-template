# Core Nexus Worktree Environment Template
# Copy this file to your worktree and customize for your specific environment

# =============================================================================
# WORKTREE IDENTIFICATION
# =============================================================================
WORKTREE_NAME=__WORKTREE_NAME__
WORKTREE_BRANCH=__WORKTREE_BRANCH__
WORKTREE_PURPOSE=__WORKTREE_PURPOSE__
ENVIRONMENT=__ENVIRONMENT__

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL with pgvector (Primary)
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=nexus_memory_db
PGVECTOR_USER=nexus_memory_db_user
PGVECTOR_PASSWORD=__SET_PASSWORD__

# Alternative database URL format
DATABASE_URL=postgresql://${PGVECTOR_USER}:${PGVECTOR_PASSWORD}@${PGVECTOR_HOST}:${PGVECTOR_PORT}/${PGVECTOR_DATABASE}

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# VECTOR PROVIDER CONFIGURATION
# =============================================================================

# Provider priority order (comma-separated)
PROVIDER_PRIORITY=pgvector,chromadb,pinecone

# ChromaDB Configuration
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=nexus_memories

# Pinecone Configuration
PINECONE_API_KEY=__SET_API_KEY__
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX_NAME=nexus-memories

# =============================================================================
# AI/ML CONFIGURATION
# =============================================================================

# OpenAI Configuration
OPENAI_API_KEY=__SET_API_KEY__
OPENAI_MODEL=gpt-4-1106-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Gemini Configuration
GEMINI_API_KEY=__SET_API_KEY__
GEMINI_MODEL=gemini-2.5-flash-lite

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Core Features
GRAPH_ENABLED=true
CACHE_ENABLED=true
METRICS_ENABLED=true
OBSERVABILITY_ENABLED=false

# Advanced Features
ADM_EVOLUTION_ENABLED=false
ADM_SCORING_ENABLED=false
BULK_IMPORT_ENABLED=true
BULK_EXPORT_ENABLED=true

# Development Features
DEBUG_MODE=false
VERBOSE_LOGGING=false
PERFORMANCE_MONITORING=false

# =============================================================================
# JARVIS AI AGENT CONFIGURATION
# =============================================================================

# JARVIS Integration
JARVIS_ENABLED=true
JARVIS_URL=https://jarvis-ai-agent-aa4m.onrender.com
JARVIS_TIMEOUT=30
JARVIS_MAX_RETRIES=3
JARVIS_API_KEY=__SET_API_KEY__

# Task Processing
JARVIS_TASK_PRIORITY=medium
JARVIS_MAX_CONTEXT_MEMORIES=5
JARVIS_REASONING_TIMEOUT=20

# =============================================================================
# API CONFIGURATION
# =============================================================================

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=60

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_METHODS=["GET","POST","PUT","DELETE"]
CORS_HEADERS=["*"]

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Authentication
AUTH_ENABLED=false
JWT_SECRET_KEY=__GENERATE_SECRET__
JWT_EXPIRATION=86400

# Admin Access
ADMIN_KEY=__SET_ADMIN_KEY__
ENABLE_NUCLEAR_ENDPOINTS=false
ENABLE_DEBUG_ENDPOINTS=false

# API Keys (if authentication enabled)
API_KEY_HEADER=X-API-Key
REQUIRE_API_KEY=false

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Log Destinations
LOG_TO_FILE=true
LOG_FILE=logs/core-nexus.log
LOG_TO_CONSOLE=true
LOG_ROTATION=true
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Component-specific logging
DB_LOG_LEVEL=WARNING
API_LOG_LEVEL=INFO
PROVIDER_LOG_LEVEL=INFO
GRAPH_LOG_LEVEL=INFO

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Caching
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_BACKEND=memory

# Timeouts
REQUEST_TIMEOUT=30
DB_QUERY_TIMEOUT=10
PROVIDER_TIMEOUT=15
EMBEDDING_TIMEOUT=20

# Retries
MAX_RETRIES=3
RETRY_DELAY=1
EXPONENTIAL_BACKOFF=true

# Batch Processing
BATCH_SIZE=100
MAX_BATCH_SIZE=1000
BATCH_TIMEOUT=60

# =============================================================================
# MONITORING AND OBSERVABILITY
# =============================================================================

# Metrics
METRICS_PORT=9090
METRICS_PATH=/metrics
PROMETHEUS_ENABLED=false

# OpenTelemetry
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=core-nexus-${WORKTREE_NAME}
OTEL_SAMPLE_RATE=0.1

# Health Checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=5

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development Mode
DEV_MODE=false
AUTO_RELOAD=false
DEBUG_QUERIES=false
PROFILING_ENABLED=false

# Testing
TEST_MODE=false
TEST_DATABASE_URL=postgresql://localhost:5432/nexus_test_db
SKIP_MIGRATIONS=false

# Mock Services
MOCK_PROVIDERS=false
MOCK_AI_SERVICES=false
SIMULATE_DELAYS=false

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================

# Docker Compose Settings
COMPOSE_PROJECT_NAME=core-nexus-${WORKTREE_NAME}
COMPOSE_FILE=docker-compose.yml

# Service Dependencies
POSTGRES_IMAGE=pgvector/pgvector:pg15
REDIS_IMAGE=redis:7-alpine
CHROMADB_IMAGE=chromadb/chroma:latest

# Volume Mounts
DATA_VOLUME=./data
LOGS_VOLUME=./logs
CONFIG_VOLUME=./config

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESSION=true

# Backup Destinations
BACKUP_LOCAL_PATH=./backups
BACKUP_S3_BUCKET=__SET_BUCKET__
BACKUP_S3_KEY=__SET_S3_KEY__
BACKUP_S3_SECRET=__SET_S3_SECRET__

# =============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =============================================================================

# Production Overrides (when ENVIRONMENT=production)
# PROD_LOG_LEVEL=WARNING
# PROD_DEBUG_MODE=false
# PROD_METRICS_ENABLED=true
# PROD_CACHE_TTL=7200

# Staging Overrides (when ENVIRONMENT=staging)
# STAGING_LOG_LEVEL=INFO
# STAGING_DEBUG_MODE=false
# STAGING_METRICS_ENABLED=true

# Development Overrides (when ENVIRONMENT=development)
# DEV_LOG_LEVEL=DEBUG
# DEV_DEBUG_MODE=true
# DEV_AUTO_RELOAD=true

# Testing Overrides (when ENVIRONMENT=testing)
# TEST_LOG_LEVEL=DEBUG
# TEST_MOCK_PROVIDERS=true
# TEST_SKIP_MIGRATIONS=true

# =============================================================================
# WORKTREE-SPECIFIC CONFIGURATION
# =============================================================================

# Agent Assignment
ASSIGNED_AGENT=__AGENT_NAME__
AGENT_CONTACT=__AGENT_CONTACT__
AGENT_SESSION_ID=__SESSION_ID__

# Workspace Settings
WORKSPACE_LOCK_TIMEOUT=3600
WORKSPACE_AUTO_SYNC=true
WORKSPACE_BACKUP_BEFORE_MAJOR_CHANGES=true

# Integration Settings
INTEGRATION_BRANCH=main
INTEGRATION_REQUIRED_TESTS=true
INTEGRATION_REQUIRED_APPROVALS=1

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Render.com Configuration
RENDER_API_KEY=__SET_RENDER_KEY__
RENDER_SERVICE_ID=__SET_SERVICE_ID__

# GitHub Configuration
GITHUB_TOKEN=__SET_GITHUB_TOKEN__
GITHUB_REPO=VonBase/core-nexus

# Notification Services
SLACK_WEBHOOK_URL=__SET_SLACK_WEBHOOK__
DISCORD_WEBHOOK_URL=__SET_DISCORD_WEBHOOK__

# =============================================================================
# CUSTOM ENVIRONMENT VARIABLES
# =============================================================================

# Add any custom environment variables here
# CUSTOM_VAR_1=value1
# CUSTOM_VAR_2=value2

# =============================================================================
# VALIDATION NOTES
# =============================================================================

# Required Variables (must be set):
# - PGVECTOR_PASSWORD (or use DATABASE_URL)
# - OPENAI_API_KEY (for embeddings)
# - WORKTREE_NAME, WORKTREE_BRANCH, ENVIRONMENT

# Optional but Recommended:
# - GEMINI_API_KEY (for JARVIS)
# - ADMIN_KEY (for admin endpoints)
# - JWT_SECRET_KEY (if auth enabled)

# Environment-Specific Requirements:
# Production: All keys must be set, debug disabled
# Staging: Database and AI keys required
# Development: Local database acceptable
# Testing: Mock services can be enabled

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================

# 1. Copy this file to your worktree directory
# 2. Rename to .env
# 3. Replace all __PLACEHOLDER__ values with actual values
# 4. Customize settings for your specific environment
# 5. Ensure sensitive values are properly secured
# 6. Test configuration with: make test

# Example customization for production worktree:
# cp .env.worktree-template ../core-nexus-production/.env
# sed -i 's/__WORKTREE_NAME__/production/' ../core-nexus-production/.env
# sed -i 's/__ENVIRONMENT__/production/' ../core-nexus-production/.env
# # ... set other values as needed
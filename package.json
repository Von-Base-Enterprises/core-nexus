{
  "name": "core-nexus",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.0.2",
  "type": "module",
  "workspaces": [
    "."
  ],
  "scripts": {
    "build": "echo 'Build step - Python services built via Poetry'",
    "test": "echo 'Tests run via Poetry - see Makefile for combined testing'",
    "lint": "eslint . --ext .js,.ts,.tsx --fix",
    "lint:fix": "eslint . --ext .js,.ts,.tsx --fix && prettier --write .",
    "type-check": "echo 'TypeScript type checking not needed - Python project'",
    "clean": "rm -rf node_modules .yarn/cache",
    "dev": "echo 'Development servers started via Poetry/Python'",
    "preinstall": "npx only-allow yarn",
    "postinstall": "husky install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "yarn install --immutable && yarn lint && yarn format:check"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.29.4",
    "@eslint/js": "^9.31.0",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^16.2.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=4.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ],
    "*.py": [
      "ruff check --fix",
      "black"
    ]
  }
}
